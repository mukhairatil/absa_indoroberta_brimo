        "def label_sentiment(score):\n",
        "    if score <= 2:\n",
        "        return \"negatif\"\n",
        "    elif score == 3:\n",
        "        return \"netral\"\n",
        "    else:\n",
        "        return \"positif\"\n",
        "\n",
        "df['sentiment'] = df['score'].apply(label_sentiment)"
